# Зразок налаштувань. Скопіюйте у .env і заповніть. Справжній .env у репозиторій не додається.
# Без файлу .env docker compose не запуститься (docker-compose.yml читає env_file: .env).

# Шляхи (у Docker задані в Dockerfile; локально — необов'язкові)
# DATA_DIR=backend/data
# FRONTEND_DIR=frontend/build

# Ключ підпису токенів входу (HMAC-SHA256). Згенерувати: python -c "import secrets; print(secrets.token_hex(32))"
# Якщо не задано — генерується випадковий при кожному запуску (усі токени зникають після перезапуску).
SECRET_KEY=замініть-на-випадковий-рядок

# Спільний демо-пароль для входу в усі ролі. ОБОВ'ЯЗКОВО змініть!
# Якщо не задано — вхід вимкнено, застосунок недоступний (гостьового режиму немає).
DEMO_PASSWORD=замініть-на-власний-пароль

# Ключі зовнішніх API не потрібні: PVGIS і Open-Meteo безкоштовні й без ключа.
