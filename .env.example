# Зразок налаштувань. Скопіюйте у .env і заповніть. Справжній .env у репозиторій не додається.

# Шляхи (у Docker задані в Dockerfile; локально — необов'язкові)
# DATA_DIR=backend/data
# FRONTEND_DIR=frontend/build

# Ключ підпису сесій (для входу за паролем, у роботі). Згенерувати: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=замініть-на-випадковий-рядок

# Демо-користувачі за ролями (у роботі). Паролі — лише тут, не в коді.
DEMO_ENERGY_MANAGER_LOGIN=energomanager
DEMO_ENERGY_MANAGER_PASSWORD=замініть
DEMO_DEPARTMENT_LOGIN=department
DEMO_DEPARTMENT_PASSWORD=замініть
DEMO_FACILITY_LOGIN=facility
DEMO_FACILITY_PASSWORD=замініть

# Ключі зовнішніх API не потрібні: PVGIS і Open-Meteo безкоштовні й без ключа.
